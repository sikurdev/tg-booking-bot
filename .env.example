# Telegram bot token from @BotFather (never commit the real value)
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Numeric Telegram user id of the business owner (get it from @userinfobot)
# Either name works:
OWNER_CHAT_ID=123456789
# OWNER_TELEGRAM_ID=123456789

# Optional bot username (informational; not required at runtime)
# BOT_USERNAME=your_bot_username

# Path to the client business YAML (default: demo salon)
BUSINESS_CONFIG=config/demo_salon.yaml

# SQLite database path
DATABASE_PATH=data/bookings.db

# Demo mode: when 1, owner notification copy is also sent to the booking user
DEMO=1

# Optional: IANA timezone for slot calculations (default Europe/Kyiv)
TIMEZONE=Europe/Kyiv
